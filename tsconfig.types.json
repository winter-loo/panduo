{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "lib": ["dom", "es2020"],
    "noImplicitOverride": true
  },
  "include": ["./src", "./entry"],
  "exclude": ["node_modules/**/*", "tools/fonts/legacy", "releases", "reference", "build", "dist"]
}
