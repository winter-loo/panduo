Abc {
  File = eol* (FileHeaders eol eol+)? TuneBook

  FileHeaders = FileHeader (eol FileHeader)*
  FileHeader
    = ReservedFileHeaderField
    | UnknownFileHeaderField --unknown

  TuneBook = Tune (eol eol+ Tune)* eol*

  Tune =
    | TuneHeader eol TuneBody --full
    | TuneHeader --onlyHeader
    | TuneBody --onlyBody
    | /* nothing */ --empty

  TuneHeader = TuneHeaderField (eol TuneHeaderField)*
  TuneHeaderField =
    | TuneHeaderStartField --start
    | TuneHeaderEndField --end
    | ReservedTuneHeaderField
    | UnknownTuneHeaderField --unknown

  TuneBody
    = (InBodyInfoFieldList eol)? TuneBodyPart (~(eol InBodyInfoFieldList) eol? TuneBodyPart)* (eol InBodyInfoFieldList)?

  TuneBodyPart
    = TuneBodyPart eol InBodyInfoFieldList eol TuneBodyPart --middle
    | InlineInfoFieldList --inline
    | MusicCode
    | reservedLetter --reserved

  MusicCode = MusicCodePart+

  // rule in front has higher priority
  MusicCodePart =
    | NoteSeq+ --noteseq
    | rest --rest
    | "(" --slurStart
    | ")" --slurEnd
    | bar --bar

  rest =
      | ("z" | "x") noteLen? --inside
      | ("Z" | "X") number? --cross

  bar = ":|2" | "||" | "[|" | "|]" | "|:" | ":|" | "[1" | "[2" | "::" | "|1" | "|"

  NoteSeq =
    | noteConstruct binaryOps noteConstruct --binary
    | NoteGroup binaryOps NoteGroup --groupBinary
    | NoteGroup brokenOp --dotted
    | PairingAnnotatedNote --pairedAnnotation
    | NoteGroup --group
    | noteConstruct

  binaryOps = binaryOp+
  binaryOp
    = brokenOp --broken
    | tieOp --tie
  brokenOp = ">"+ | "<"+
  tieOp = "-"

  baseNoteGroup
    = "[" annotatedNote+ "]" noteLen? --chord
    | "(" #(digit) annotatedNote+ --nplet
    | annotatedNote binaryOp annotatedNote --binary
    | annotatedNote+

  NoteGroup = chordAnnotation? baseNoteGroup

  noteConstruct = (graceNote spaces)? chordedNote
  graceNote = "{" spaces baseNote+ spaces "}"
  chordedNote = (chordAnnotation spaces)? annotatedNote

  // slur symbols could exist between annotation and baseNote
  annotatedNote = (annotationOp spaces)? ("(" spaces)? baseNote
  annotationOp =
    | annotationOp annotationOp --concat
    | annotationOp space+ annotationOp --gap
    | annotation

  chordAnnotation = "\"" chordAnnoText "\""
  // <note><accidental><type></bass>
  chordAnnoText = "A".."G" #(chordAnnoSharp)? #(chordAnnoType)? #("/" ("A".."G" | "a".."g"))?
  chordAnnoSharp = "b" | "#" | "\u266d" | "\u266e" | "\u266f"
  chordAnnoType =
    | chordAnnoType chordAnnoType --many
    | "m" | "min" | "maj" | "dim" | "aug" | "+" | "sus" | number

  PairingAnnotatedNote
    = chordAnnotation? "!trill(!" PairingMiddle "!trill)!" baseNote
    | chordAnnotation? "!crescendo(!" PairingMiddle "!crescendo)!" baseNote
    | chordAnnotation? "!<(!" PairingMiddle "!<)!" baseNote
    | chordAnnotation? "!diminuendo(!" PairingMiddle "!diminuendo)!" baseNote
    | chordAnnotation? "!>(!" PairingMiddle "!>)!" baseNote
  PairingMiddle = baseNote NoteSeq* chordAnnotation?

  baseNote = accidental? pitch noteLen?
  pitch = noteName octave?

  // decorations may be applied to notes, rests, note groups, and bar lines
  annotation =
    | "\"" annoText "\"" --anno
    | decoration --deco
  annoText = (~(eol | "\"") any)*

  decoration =
    | "."
    | "~"
    | "H"
    | "L"
    | "M"
    | "O"
    | "P"
    | "S"
    | "T"
    | "u"
    | "v"
    | "!trill!"
    | "!lowermordent!"
    | "!uppermordent!"
    | "!mordent!"
    | "!pralltriller!"
    | "!roll!"
    | "!turn!"
    | "!turnx!"
    | "!invertedturn!"
    | "!invertedturnx!"
    | "!arpeggio!"
    | "!>!"
    | "!accent!"
    | "!emphasis!"
    | "!fermata!"
    | "!invertedfermata!"
    | "!tenuto!"
    | "!0!"
    | "!1!"
    | "!2!"
    | "!3!"
    | "!4!"
    | "!5!"
    | "!+!"
    | "!plus!"
    | "!snap!"
    | "!slide!"
    | "!wedge!"
    | "!upbow!"
    | "!downbow!"
    | "!open!"
    | "!thumb!"
    | "!breath!"
    | "!pppp!"
    | "!ppp!"
    | "!pp!"
    | "!p!"
    | "!mp!"
    | "!mf!"
    | "!f!"
    | "!ff!"
    | "!fff!"
    | "!ffff!"
    | "!sfz!"
    | "!segno!"
    | "!coda!"
    | "!D.S.!"
    | "!D.C.!"
    | "!dacoda!"
    | "!dacapo!"
    | "!fine!"
    | "!shortphrase!"
    | "!mediumphrase!"
    | "!longphrase!"

  accidental = "^"+ | "_"+ | "="
  noteName = "A".."G" | "a".."g"
  octave = ","+ | "'"+
  noteLen =
    | number "/" number --fra
    | "/" number        --div
    | "/"+              --half
    | number            --mul

  InlineInfoFieldList = InlineInfoField+
  InlineInfoField = "[" InlineInfoFieldX "]"
  InlineInfoFieldX =
    | ReservedInlineField
    | UnknownField --unknown
  inlineFieldValue = (~(eol | "]" | "[") any)*
  InBodyInfoFieldList = InBodyInfoField (eol InBodyInfoField)*
  InBodyInfoField =
    | ReservedInBodyField
    | UnknownField --unknown

  TuneHeaderStartField = "X:" number
  TuneHeaderEndField   = KeySignatureSetting

  ReservedFileHeaderField
    = ReservedHeaderOnlyField
    | ReservedCommonField<oneLineValue>

  ReservedTuneHeaderField =
    | ReservedTuneHeaderFieldX
    | ReservedHeaderOnlyField
    | ReservedCommonField<oneLineValue>

  ReservedTuneHeaderFieldX =
    | "P:" oneLineValue --part
    | TempoSetting --tempo
    | "T:" oneLineValue --title
    | VoiceSetting --voice
    | "W:" oneLineValue --wordsAfter

  ReservedInBodyField =
    | ReservedInBodyFieldX
    | ReservedCommonField<oneLineValue>

  ReservedInBodyFieldX =
  	| KeySignatureSetting --keysig
    | "P:" oneLineValue --part
    | TempoSetting --tempo
    | "s:" oneLineValue --symbolLine
    | "T:" oneLineValue --tuneTitle
    | VoiceSetting --voice
    | "W:" oneLineValue --wordsAfter
    | "w:" oneLineValue --wordsParallel

  ReservedInlineField =
    | ReservedInlineFieldX
    | ReservedCommonField<inlineFieldValue>

  ReservedInlineFieldX =
   	| KeySignatureSetting --keysig
    | "P:" inlineFieldValue --part
    | TempoSetting --tempo
    | "R:" inlineFieldValue --rhythm
    | VoiceSetting --voice

  ReservedHeaderOnlyField =
    | "A:" oneLineValue
    | "B:" oneLineValue
    | "C:" oneLineValue
    | "D:" oneLineValue
    | "F:" oneLineValue
    | "G:" oneLineValue
    | "H:" oneLineValue
    | "S:" oneLineValue
    | "Z:" manyLineValue
    | "O:" oneLineValue

  ReservedCommonField<value> =
    | "I:" "linebreak" space+ linebreakMarks --instruction
    | UnitNoteLengthSetting --unitlen
    | MeterSetting
    | "m:" value --macro
    | "N:" value --notes
    | "R:" value --rhythm
    | "r:" value --remark
    | "U:" value --userDefined
    | fieldContinue value --fieldContinue

  MeterSetting = "M:" spaces noteLen
  UnitNoteLengthSetting = "L:" "1" "/" unitNoteLength
  unitNoteLength = "16" | "32" | "64" | "1" | "2" | "4" | "8"

  VoiceSetting = "V:" word VoiceProperty*
  VoiceProperty
    = voicePropertyName "=" "\"" (~"\"" any)+ "\"" --name
    | voicePropertySubName "=" "\"" (~"\"" any)+ "\"" --subname
    | "stem" "=" ("up" | "down") --stem
    | ("clef" "=")? clefProperty --clef
  voicePropertyName = "name" | "nm"
  voicePropertySubName = "subname" | "sname" | "snm"

  TempoSetting
    = "Q:" QKeyedValue --tempo
  QKeyedValue = dqTextString? (number "/" number "=")? number dqTextString?

  KeySignatureSetting
    = "K:" keySignatureTonic keySignatureMode? (space+ accidental noteName)?
  keySignatureTonic = "A".."G" ("#" | "b")?
  keySignatureMode = "maj" | "min" | "m" | "Mix" | "Dor" | "Phr" | "Lyd" | "Loc"

  // <clef name>[<line number>][+8 | -8] [middle=<pitch>] [transpose=<semitones>] [octave=<number>] [stafflines=<lines>]
  clefProperty = (clefPropertyOpt space+)* clefName number? ("+8" | "-8")? (space+ clefPropertyOpt)*
  clefPropertyOpt
    = ("middle" | "m") spaces "=" spaces pitch --middle
    | ("transpose" | "t") spaces "=" spaces mathNumber --transpose
    | "octave" spaces "=" spaces mathNumber --octave
    | "stafflines" spaces "=" spaces number --lines
  clefName = "treble" | "bass" | "bass3" | "tenor" | "alto" | "alto2" | "alto1"

  linebreakMarks = linebreakMark (space+ linebreakMark)*
  linebreakMark
    = "$"
    | "!"
    | "<EOL>"
    | "<none>"

  UnknownFileHeaderField = ~(ReservedFileHeaderField) key oneLineValue
  UnknownTuneHeaderField = ~(ReservedTuneHeaderField | TuneHeaderStartField | TuneHeaderEndField) key oneLineValue
  UnknownField = ~(ReservedInBodyField | ReservedInlineField | ReservedTuneHeaderField | ReservedFileHeaderField) key (oneLineValue | inlineFieldValue)

  key = letter ":"
  textString  = (~(eol | "\"") any)*
  dqTextString = "\"" textString "\""
  // allow newline in value but line beginning with letter + colon
  // is a marker for info field
  oneLineValue  = (~(eol | "%") any)*
  manyLineValue = (~(eol key) any)*
  comment = (~"%%" "%") (~eol any)*
  commentLine
    = comment eol --comment
    | stylesheetDirective spaces eol --directive

  stylesheetDirective = "%%" spaces stylesheetDirectiveDetail
  stylesheetDirectiveDetail
    = voiceGroupSetting
    | oneLineValue
  voiceGroupSetting = "score" spaces voiceGroup+
  voiceGroup
    = "(" spaces voiceGroup+ spaces ")" --group
    | "{" spaces voiceGroup+ spaces "}" --brace
    | "[" spaces voiceGroup+ spaces "]" --bracket
    | voiceGroup spaces "|" spaces voiceGroup --barContinue
    | word --name
  word = alnum+

  eol =
    | eol commentLine --lineComment
    | "\\" spaces eol --lineContinue
    | "\r\n" | "\n" | "\r"
  space := " " | "\t" | comment
  number = digit+
  positiveNumber = "+"? number
  negativeNumber = "-" number
  mathNumber = positiveNumber | negativeNumber
  fieldContinue = "+:"
  reservedLetter =
    | "!" | "\"" | "#" | "$" | "%" | "&" | "*" | "+"
    | "-" | "." | "/" | ":" | ";" | "<" | "=" | ">" | "?" | "@"
    | "`" | "~"
    | "0".."9" | "A".."Z" | "a".."z"
}
