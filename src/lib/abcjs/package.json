{
  "name": "abcjs",
  "version": "6.5.2",
  "description": "Renderer for abc music notation",
  "main": "index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:basic && npm run build:basic-min && npm run build:plugin",
    "build:basic": "vite build --mode basic",
    "build:basic-min": "vite build --mode basic-min",
    "build:plugin": "vite build --mode plugin",
    "test-server": "npx http-server",
    "test": "concurrently \"http-server\" \"npx opener http://localhost:8080/tests/all.html\"",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "build:analyze": "vite build --mode analyze"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulrosen/abcjs.git"
  },
  "keywords": [
    "abc",
    "music",
    "notation",
    "midi",
    "webaudio"
  ],
  "author": "Paul Rosen <paul@paulrosen.net> (https://abcjs.net)",
  "contributors": [
    "Gregory Dyke",
    "Jean-Yves Mengant",
    "Todd Brown",
    "Thomas Chandelle"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/paulrosen/abcjs/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/paulrosen"
  },
  "homepage": "https://abcjs.net",
  "devDependencies": {
    "@tarp/require": "1.4.3",
    "chai": "4.3.7",
    "concurrently": "7.6.0",
    "http-server": "14.1.1",
    "mocha": "10.2.0",
    "opener": "1.5.2",
    "rollup-plugin-visualizer": "5.12.0",
    "vuepress": "2.0.0-beta.60",
    "vuex": "4.1.0",
    "vite": "5.1.4"
  }
}
